#!/bin/bash
set -euo pipefail

# Run prettier on .ts files changed since the branching point.
BASE_REF=$(git rev-parse --verify --quiet upstream/main || echo origin/main)
MERGE_BASE=$(git merge-base "$BASE_REF" HEAD)
git diff -z --name-only --diff-filter=ACMR "$MERGE_BASE" -- '*.ts' \
  | xargs -0 -r bazel run //:prettier -- --ignore-path .prettierignore --write
