#!/bin/bash
set -e

# Run eslint.
bazel run //:eslint -- '**/*.ts'

# Run prettier on .ts files changed since the branching point
BASE_REF=$(git rev-parse --verify --quiet upstream/main || echo origin/main)
git diff -z --name-only --diff-filter=ACMR "$(git merge-base $BASE_REF HEAD)" -- '*.ts' \
  | xargs -0 -r bazel run //:prettier -- --ignore-path .prettierignore --check
