#!/bin/bash
# Prefetches new npm dependencies of open Dependabot PRs through a configurable
# registry.
#
# For every open PR by PR_AUTHOR, compares its pnpm-lock.yaml with the lockfile
# of its base commit and downloads each new package version from
# PREFETCH_REGISTRY. This makes that registry pick up the new versions ahead of
# the test builds that need them. Each package is fetched separately, so one
# failure doesn't stop the others.
#
# Usage:
#   REPO_TOKEN=<token> PREFETCH_REGISTRY=<host/path/> ./scripts/prefetch_npm_deps
#
# Failures are reported as warnings and never fail the build.
set -uo pipefail

: "${REPO_TOKEN:?REPO_TOKEN must be set}"
: "${PREFETCH_REGISTRY:?PREFETCH_REGISTRY must be set, e.g. registry.example.com/npm/}"
GITHUB_REPO="${GITHUB_REPO:-dataform-co/dataform}"
PR_AUTHOR="${PR_AUTHOR:-dependabot[bot]}" # Override for testing.

WORK_DIR="$(mktemp -d)"
trap 'rm -rf "${WORK_DIR}"' EXIT

warn() { echo "WARNING: $*" >&2; }

# Prints "name version" for every package in the lockfile's `packages:` section.
list_packages() {
  python3 - "$1" <<'EOF'
import re, sys
in_packages = False
for line in open(sys.argv[1]):
    if line.startswith("packages:"):
        in_packages = True
        continue
    if in_packages and line.strip() and not line[0].isspace():
        break
    m = re.match(r"^  '?(@?[^@\s']+)@([^(:'\s]+)", line) if in_packages else None
    if m:
        print(m.group(1), m.group(2))
EOF
}

download_lockfile() { # sha output
  curl -fsSL -o "$2" "https://raw.githubusercontent.com/${GITHUB_REPO}/$1/pnpm-lock.yaml"
}

prefetch_package() { # name version
  local name="$1" version="$2"
  local url="https://${PREFETCH_REGISTRY}${name}/-/${name##*/}-${version}.tgz"
  if curl -fsS -o /dev/null -H "Authorization: Bearer ${REPO_TOKEN}" "${url}"; then
    echo "  fetched ${name}@${version}"
  else
    warn "could not fetch ${name}@${version} yet"
  fi
}

# Public repo: the unauthenticated GitHub API is sufficient.
prs="$(curl -fsSL "https://api.github.com/repos/${GITHUB_REPO}/pulls?state=open&per_page=100" |
  PR_AUTHOR="${PR_AUTHOR}" python3 -c 'import json,os,sys
for pr in json.load(sys.stdin):
    if pr["user"]["login"] == os.environ["PR_AUTHOR"]:
        print(pr["number"], pr["head"]["sha"], pr["base"]["sha"])' 2>/dev/null)" ||
  { warn "could not list open PRs"; prs=""; }

while read -r number head base; do
  [[ -z "${number}" ]] && continue
  echo "=== PR #${number}"
  if ! download_lockfile "${head}" "${WORK_DIR}/head.yaml" ||
     ! download_lockfile "${base}" "${WORK_DIR}/base.yaml"; then
    warn "could not download lockfiles for PR #${number}"
    continue
  fi
  comm -13 <(list_packages "${WORK_DIR}/base.yaml" | sort) \
           <(list_packages "${WORK_DIR}/head.yaml" | sort) |
  while read -r name version; do
    prefetch_package "${name}" "${version}"
  done
done <<< "${prs}"
