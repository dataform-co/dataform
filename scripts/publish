#!/bin/bash
set -e

# This can be uncommented once it no longer throws an error exit code.
# ./scripts/regenerate_docs

if [ "$(git status --porcelain)" ]; then
    echo "There are uncommitted changes; aborting." 1>&2
    exit 1
fi

# Validate version and branch/tag rules before running tests, without writing
# publish_all.json. In Cloud Build the follow-up release build needs the branch,
# so fail here rather than after the packages are uploaded.
if [ -n "${BUILD_ID:-}" ] && [ -z "${BRANCH_NAME:-}" ]; then
    echo "BRANCH_NAME must be set when running in Cloud Build; aborting." 1>&2
    exit 1
fi
BRANCH="${BRANCH_NAME:-$(git rev-parse --abbrev-ref HEAD)}"
./scripts/write_exit_gate_manifest --check-only "${BRANCH}"

# Run all the tests.
bazel test //... --build_tests_only --action_env=CLOUDSDK_CONTEXT_AWARE_USE_CLIENT_CERTIFICATE

bazel build //packages/@dataform/cli:package //packages/@dataform/core:package

rm -rf npm_packages
mkdir -p npm_packages
cp -rL bazel-bin/packages/@dataform/cli/package npm_packages/cli
cp -rL bazel-bin/packages/@dataform/core/package npm_packages/core
chmod -R u+w npm_packages
