#!/bin/bash
set -euo pipefail

# In case script is run directly
_PR_NUMBER="${_PR_NUMBER:-0}"

if [[ -z "${_CANARY_GCP_PROJECT:-}" || -z "${_CANARY_LOCATION:-}" || -z "${_CANARY_REPO:-}" || -z "${_CANARY_BUCKET:-}" || -z "${_CANARY_SERVICE_ACCOUNT:-}" ]]; then
  echo "Error: _CANARY_GCP_PROJECT, _CANARY_LOCATION, _CANARY_REPO, _CANARY_BUCKET and _CANARY_SERVICE_ACCOUNT must be set." 1>&2
  exit 1
fi

CURRENT_VERSION=$(grep -oP '(?<=DF_VERSION = ")[^"]+' version.bzl)
if [[ -n "${BUILD_ID:-}" ]]; then
  # On Cloud Build, the tarball was built by scripts/build_canary_core_bundle with this version.
  RUN_ID="${BUILD_ID}"
  CANARY_VERSION="${CURRENT_VERSION}-${_PR_NUMBER}-${BUILD_ID}"
else
  # When run manually, assume the tarball was built from the current version.bzl:
  #   bazel build //packages/@dataform/core:package_tar
  RUN_ID=$(date +%s)
  CANARY_VERSION="${CURRENT_VERSION}"
fi

LOCAL_TARBALL="bazel-bin/packages/@dataform/core/package.tar.gz"
if [[ ! -f "${LOCAL_TARBALL}" ]]; then
  echo "Error: ${LOCAL_TARBALL} not found. Build it with: bazel build //packages/@dataform/core:package_tar" 1>&2
  exit 1
fi

PROJECT_LOCATION_PATH="projects/${_CANARY_GCP_PROJECT}/locations/${_CANARY_LOCATION}"
REPO_PATH="${PROJECT_LOCATION_PATH}/repositories/${_CANARY_REPO}"
REPO_URL="https://dataform.googleapis.com/v1/${REPO_PATH}"
WORKSPACE_ID="pr-${_PR_NUMBER}-${RUN_ID}"
WORKSPACE_CREATED=false
TARBALL_NAME="build-${_PR_NUMBER}-${RUN_ID}.tar.gz"
TMP_DIR=$(mktemp -d)

cleanup() {
  if [[ "$WORKSPACE_CREATED" == "true" && -n "${GCP_TOKEN:-}" ]]; then
    echo "Cleaning up temporary Dataform workspace: ${WORKSPACE_ID}"
    curl -s -X DELETE \
      -H "Authorization: Bearer ${GCP_TOKEN}" \
      "${REPO_URL}/workspaces/${WORKSPACE_ID}" || true
  fi
  rm -rf "${TMP_DIR}"
}
trap cleanup EXIT

# When running on cloudbuild, the token will have been generated in the previous steps
if [[ -f ~/gcp_token.txt ]]; then
  GCP_TOKEN=$(cat ~/gcp_token.txt)
elif command -v gcloud >/dev/null 2>&1; then
  GCP_TOKEN=$(gcloud auth application-default print-access-token)
else
  echo "Error: Unable to obtain GCP access token." 1>&2
  exit 1
fi

echo "Verifying GCS bucket exists: ${_CANARY_BUCKET}"
if ! gcloud storage buckets describe "gs://${_CANARY_BUCKET}" --format="value(name)" >/dev/null; then
  echo "Error verifying GCS bucket ${_CANARY_BUCKET}." 1>&2
  echo "This is most likely an infra failure, not an issue with the Dataform code"
  exit 1
fi

echo "Uploading Core tarball to gs://${_CANARY_BUCKET}/${TARBALL_NAME}..."
if ! gcloud storage cp "${LOCAL_TARBALL}" "gs://${_CANARY_BUCKET}/${TARBALL_NAME}"; then
  echo "Error uploading Core tarball to GCS." 1>&2
  echo "This is most likely an infra failure, not an issue with the Dataform code"
  exit 1
fi

echo "Checking that Dataform repository exists: ${_CANARY_REPO}"
GET_REPO_HTTP_CODE=$(curl -s -o "${TMP_DIR}/get_repo_response.json" -w "%{http_code}" \
  -X GET \
  -H "Authorization: Bearer ${GCP_TOKEN}" \
  "${REPO_URL}")
if [[ "$GET_REPO_HTTP_CODE" -lt 200 || "$GET_REPO_HTTP_CODE" -ge 300 ]]; then
  echo "Error checking Dataform repository (HTTP ${GET_REPO_HTTP_CODE}):" 1>&2
  echo "This is most likely an infra failure, not an issue with the Dataform code"
  cat "${TMP_DIR}/get_repo_response.json" 1>&2
  exit 1
fi

echo "Creating temporary Dataform workspace: ${WORKSPACE_ID}"
CREATE_WS_HTTP_CODE=$(curl -s -o "${TMP_DIR}/create_ws_response.json" -w "%{http_code}" \
  -X POST \
  -H "Authorization: Bearer ${GCP_TOKEN}" \
  -H "Content-Type: application/json" \
  "${REPO_URL}/workspaces?workspaceId=${WORKSPACE_ID}" \
  -d "{}")
if [[ "$CREATE_WS_HTTP_CODE" -lt 200 || "$CREATE_WS_HTTP_CODE" -ge 300 ]]; then
  echo "Error creating Dataform workspace (HTTP ${CREATE_WS_HTTP_CODE}):" 1>&2
  echo "This is most likely an infra failure, not an issue with the Dataform code"
  cat "${TMP_DIR}/create_ws_response.json" 1>&2
  exit 1
fi
WORKSPACE_CREATED=true

write_workspace_file() {
  local rel_path="$1"
  local encoded_contents="$2"
  local write_http_code
  write_http_code=$(curl -s -o "${TMP_DIR}/write_file_response.json" -w "%{http_code}" \
    -X POST \
    -H "Authorization: Bearer ${GCP_TOKEN}" \
    -H "Content-Type: application/json" \
    "${REPO_URL}/workspaces/${WORKSPACE_ID}:writeFile" \
    -d "$(python3 -c 'import json, sys; print(json.dumps({"path": sys.argv[1], "contents": sys.argv[2]}))' "$rel_path" "$encoded_contents")")

  if [[ "$write_http_code" -lt 200 || "$write_http_code" -ge 300 ]]; then
    echo "Error uploading ${rel_path} to workspace (HTTP ${write_http_code}):" 1>&2
    echo "This is most likely an infra failure, not an issue with the Dataform code"
    cat "${TMP_DIR}/write_file_response.json" 1>&2
    exit 1
  fi
}

echo "Uploading canary project files from tools/canary-project/..."
while IFS= read -r -d '' file; do
  rel_path="${file#tools/canary-project/}"
  encoded_contents=$(base64 -w 0 "$file")
  write_workspace_file "$rel_path" "$encoded_contents"
done < <(find tools/canary-project -type f -print0)

echo "Uploading workflow_settings.yaml..."
WORKFLOW_SETTINGS_CONTENTS=$(cat <<EOF | base64 -w 0
defaultProject: ${_CANARY_GCP_PROJECT}
defaultLocation: ${_CANARY_LOCATION}
defaultDataset: dataform_canary
defaultAssertionDataset: dataform_canary_assertions
EOF
)
write_workspace_file "workflow_settings.yaml" "$WORKFLOW_SETTINGS_CONTENTS"

echo "Generating V4 signed URL for gs://${_CANARY_BUCKET}/${TARBALL_NAME}..."
SIGNED_TARBALL_URL=$(gcloud storage sign-url "gs://${_CANARY_BUCKET}/${TARBALL_NAME}" \
  --impersonate-service-account="${_CANARY_SERVICE_ACCOUNT}" \
  --duration=10m \
  --region="${_CANARY_LOCATION}" \
  --format="value(signed_url)")

echo "Uploading package.json referencing ${SIGNED_TARBALL_URL}..."
PACKAGE_JSON_CONTENTS=$(cat <<EOF | base64 -w 0
{
  "name": "canary-project",
  "dependencies": {
    "@dataform/core": "${SIGNED_TARBALL_URL}"
  }
}
EOF
)
write_workspace_file "package.json" "$PACKAGE_JSON_CONTENTS"

echo "Installing NPM packages in workspace..."
INSTALL_HTTP_CODE=$(curl --retry 3 --retry-all-errors --retry-delay 5 -s -o "${TMP_DIR}/install_response.json" -w "%{http_code}" \
  -X POST \
  -H "Authorization: Bearer ${GCP_TOKEN}" \
  -H "Content-Type: application/json" \
  "${REPO_URL}/workspaces/${WORKSPACE_ID}:installNpmPackages" \
  -d "{}")
if [[ "$INSTALL_HTTP_CODE" -lt 200 || "$INSTALL_HTTP_CODE" -ge 300 ]]; then
  echo "Error calling workspaces.installNpmPackages (HTTP ${INSTALL_HTTP_CODE}):" 1>&2
  echo "This is most likely an infra or npm failure, not an issue with the Dataform code"
  cat "${TMP_DIR}/install_response.json" 1>&2
  exit 1
fi

echo "Compiling canary project via dataform.googleapis.com..."
COMPILE_HTTP_CODE=$(curl -s -o "${TMP_DIR}/compile_response.json" -w "%{http_code}" \
  -X POST \
  -H "Authorization: Bearer ${GCP_TOKEN}" \
  -H "Content-Type: application/json" \
  "${REPO_URL}/compilationResults" \
  -d "$(python3 -c 'import json, sys; print(json.dumps({"workspace": sys.argv[1]}))' "${REPO_PATH}/workspaces/${WORKSPACE_ID}")")
if [[ "$COMPILE_HTTP_CODE" -lt 200 || "$COMPILE_HTTP_CODE" -ge 300 ]]; then
  echo "Error calling compilationResults.create (HTTP ${COMPILE_HTTP_CODE}):" 1>&2
  cat "${TMP_DIR}/compile_response.json" 1>&2
  exit 1
fi

python3 - "${TMP_DIR}/compile_response.json" "${CANARY_VERSION}" <<'EOF'
import json
import sys

with open(sys.argv[1], "r", encoding="utf-8") as f:
    resp = json.load(f)
expected_version = sys.argv[2]

errors = resp.get("compilationErrors", [])
if errors:
    sys.stderr.write("Canary compilation failed with errors:\n")
    for err in errors:
        path = err.get("path", "<unknown>")
        msg = err.get("message", "")
        stack = err.get("stack", "")
        sys.stderr.write(f"  - [{path}] {msg}\n")
        if stack:
            sys.stderr.write(f"    {stack}\n")
    sys.exit(1)

actual_version = resp.get("dataformCoreVersion")
if actual_version != expected_version:
    sys.stderr.write(
        f"Canary compilation version mismatch: expected '{expected_version}', got '{actual_version}'\n"
    )
    sys.exit(1)

print(f"Canary compilation succeeded: {resp.get('name', 'OK')} (resolved version: {resp.get('dataformCoreVersion', 'workspace')})")
EOF
