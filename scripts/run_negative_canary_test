#!/bin/bash
set -euo pipefail

# Negative counterpart of scripts/run_canary_test: uploads the deliberately broken Core bundle
# tools/canary/negative/package.tar.gz, tries to compile the canary project with it via
# dataform.googleapis.com, and verifies that compilation fails with the error in
# tools/canary/negative/expected_error.json. This guards against the canary test passing
# vacuously (e.g. because the uploaded bundle is not actually the one used for compilation).
#
# By default, this script uses the dataform-open-source GCP project,
# taking the configuration from tools/canary/config.env. If you want to
# run this test manually on your own project, create a file
# tools/canary/config.local.env and provide overrides for each variable.
#
# Usage: scripts/run_negative_canary_test
if [[ -n "${1:-}" ]]; then
  echo "Error: unknown argument '${1}'." 1>&2
  exit 1
fi

source "tools/canary/scripts/setup"

NEGATIVE_DIR="${CANARY_DIR}/negative"

EXPECTED_ERROR_FILE="${NEGATIVE_DIR}/expected_error.json"
if [[ ! -f "${EXPECTED_ERROR_FILE}" ]]; then
  echo "Error: ${EXPECTED_ERROR_FILE} not found." 1>&2
  exit 1
fi

LOCAL_TARBALL="${NEGATIVE_DIR}/package.tar.gz"
if [[ ! -f "${LOCAL_TARBALL}" ]]; then
  echo "Error: ${LOCAL_TARBALL} not found." 1>&2
  exit 1
fi

WORKSPACE_ID="pr-${_PR_NUMBER}-${RUN_ID}-negative"
TARBALL_NAME="build-${_PR_NUMBER}-${RUN_ID}-negative.tar.gz"
TMP_DIR=$(mktemp -d)
trap 'rm -rf "${TMP_DIR}"' EXIT

SIGNED_TARBALL_URL=$(
  LOCAL_TARBALL="${LOCAL_TARBALL}" \
  TARBALL_NAME="${TARBALL_NAME}" \
  "${CANARY_DIR}/scripts/upload_canary_tarball"
)

PROJECT_DIR="${CANARY_DIR}/project" \
TARBALL_URL="${SIGNED_TARBALL_URL}" \
WORKSPACE_ID="${WORKSPACE_ID}" \
EXPECT_ERROR=true \
"${CANARY_DIR}/scripts/compile_canary_project" \
  > "${TMP_DIR}/compile_response.json"

echo "Comparing compilationResults.create response against ${EXPECTED_ERROR_FILE}..."
python3 - "${TMP_DIR}/compile_response.json" "${EXPECTED_ERROR_FILE}" <<'EOF'
import difflib
import json
import sys

actual_path, expected_path = sys.argv[1:3]

with open(actual_path, "r", encoding="utf-8") as f:
    actual_raw = f.read()
with open(expected_path, "r", encoding="utf-8") as f:
    expected = json.load(f)

try:
    actual = json.loads(actual_raw)
except json.JSONDecodeError:
    sys.stderr.write("compilationResults.create returned a non-JSON response:\n")
    sys.stderr.write(actual_raw + "\n")
    sys.exit(1)

if actual != expected:
    sys.stderr.write("Negative canary compilation failed, but not with the expected error:\n")
    actual_str = json.dumps(actual, indent=2, sort_keys=True).splitlines()
    expected_str = json.dumps(expected, indent=2, sort_keys=True).splitlines()
    for line in difflib.unified_diff(expected_str, actual_str, fromfile="expected", tofile="actual", lineterm=""):
        sys.stderr.write(line + "\n")
    sys.exit(1)

print(f"Negative canary compilation failed with the expected error: {expected.get('error', {}).get('message', '')}")
EOF
