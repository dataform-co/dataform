#!/bin/bash
set -e

# Run lint and format checks
# Need origin/main to check which files to format
if [ "$(git rev-parse --is-shallow-repository)" = "true" ]; then
  git fetch --unshallow origin +refs/heads/main:refs/remotes/origin/main
else
  git fetch origin +refs/heads/main:refs/remotes/origin/main
fi
git rev-parse --verify --quiet origin/main >/dev/null || { echo "origin/main unavailable; cannot compute changed files" >&2; exit 1; }
./scripts/lint

# Run unit tests. The cli/README.md tests (tag cli_docs) are skipped here: they run on GitHub
# Actions (build-linux job in .github/workflows/test.yaml) for every PR, including forks.
./scripts/run_tests --test_tag_filters=-integration,-cli_docs

# Run integration tests
./scripts/run_integration_tests
