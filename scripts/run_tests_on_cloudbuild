#!/bin/bash
set -e

bazel run @nodejs//:yarn config set registry https://us-npm.pkg.dev/artifact-foundry-prod/npm-3p-trusted/
bazel run //tools/registry-tools:switch_registry -- $(pwd)/yarn.lock https://us-npm.pkg.dev/artifact-foundry-prod/npm-3p-trusted/
# Install from trusted registry, prohibit lockfile changes.
bazel run @nodejs//:yarn install -- --frozen-lockfile

# Run lint and format checks
# Need origin/main to check which files to format
if [ "$(git rev-parse --is-shallow-repository)" = "true" ]; then
  git fetch --unshallow origin +refs/heads/main:refs/remotes/origin/main
else
  git fetch origin +refs/heads/main:refs/remotes/origin/main
fi
git rev-parse --verify --quiet origin/main >/dev/null || { echo "origin/main unavailable; cannot compute changed files" >&2; exit 1; }
./scripts/lint

# Run unit tests
./scripts/run_tests

# Run integration tests
./scripts/run_integration_tests

# Run GCP canary project compile
./scripts/run_canary_test
