#!/usr/bin/env bash
set -euo pipefail

CHECK_ONLY=false
if [ "${1:-}" = "--check-only" ]; then
    CHECK_ONLY=true
    shift
fi

BRANCH="${1:-}"
if [ -z "${BRANCH}" ]; then
    echo "Branch argument is required; aborting." >&2
    exit 1
fi

VERSION=$(grep 'DF_VERSION' version.bzl | awk '{ print $3 }' | tr -d '"')

TAG=next

# If the version is a normal release (1.2.3) and not pre-release e.g (1.2.3-alpha.1) then publish with the 'latest' tag.
if [[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    TAG=latest

    if [ "main" != "$BRANCH" ]; then
        echo "Not on the 'main' branch (got '$BRANCH'); aborting." >&2
        exit 1
    fi
fi

if [ "$CHECK_ONLY" = true ]; then
    echo "Validated version '$VERSION' (tag '$TAG', branch '$BRANCH')."
    exit 0
fi

echo "Publishing as '$TAG' based on version: $VERSION"

cat <<EOF > publish_all.json
{
  "publish_all": true,
  "registry_config": {
    "npm": {
      "tags": ["$TAG"]
    }
  }
}
EOF
