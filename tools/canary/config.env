# Default configuration for scripts/run_canary_test and scripts/regenerate_canary_baseline.
# This file is sourced by bash.
#
# To use different values locally, create tools/canary/config.local.env (untracked). If it exists,
# it is used instead of this file, so it must define all of the variables below.

_CANARY_GCP_PROJECT=dataform-open-source
_CANARY_LOCATION=us-central1
_CANARY_REPO=canary-repo
_CANARY_BUCKET=dataform-open-source-canary-builds
_CANARY_SERVICE_ACCOUNT=dataform-canary-reader@dataform-open-source.iam.gserviceaccount.com
